# The shell guests get. Only the room workspace is mounted into it.
# Keep this image lean; the agent CLIs live in Dockerfile.room.full.
FROM node:22-bookworm-slim

RUN apt-get -o Acquire::ForceIPv4=true update && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
      bash git git-lfs curl ca-certificates ripgrep less vim-tiny python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && git lfs install --system

# the base image already ships uid 1000 as `node`
USER node
WORKDIR /workspace
CMD ["bash", "-l"]
