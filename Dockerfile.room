# The shell guests get. Only the room workspace is mounted into it.
FROM node:22-bookworm-slim

RUN apt-get -o Acquire::ForceIPv4=true update && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
      bash git git-lfs curl ca-certificates ripgrep less vim-tiny \
  && rm -rf /var/lib/apt/lists/* \
  && git lfs install --system

# Agent CLIs, so people can sign in and drive their own agent in their terminal.
# Best effort: a renamed package must not break the image build.
RUN npm install -g --no-audit --no-fund \
      @anthropic-ai/claude-code @openai/codex @xai-official/grok @github/copilot \
  || npm install -g --no-audit --no-fund @anthropic-ai/claude-code @openai/codex

# the base image already ships uid 1000 as `node`
USER node
WORKDIR /workspace
CMD ["bash", "-l"]
